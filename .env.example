GST_RATE=18

# WhatsApp notifications (Gupshup / Interakt / Meta Cloud API)
WHATSAPP_PROVIDER=gupshup
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_TEMPLATE_SALE=sale_alert_v1
WHATSAPP_TEMPLATE_DROP=drop_published_v1
