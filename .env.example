AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
CONTACT_TO_EMAIL=
SUPPORT_EMAIL=support@trishulbeats.com

# GST / Invoice (optional — leave blank until GST-registered)
PLATFORM_GSTIN=
PLATFORM_LEGAL_NAME=
